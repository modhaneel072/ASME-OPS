# Copy to .env for local development. Every variable the app reads is listed
# here with a safe default; nothing in this file is a real secret.
#
# On the hosting platform these are set in the dashboard instead, and render.yaml
# already declares the ones the deployed service needs.

# ---------------------------------------------------------------- core runtime
# development | production | testing. Development auto-migrates and is lenient;
# production validates strictly and refuses to start if something is unsafe.
ASME_ENV=development
# Signs session cookies, download links and password-reset tokens. Changing it
# signs everyone out and breaks links already sent. The host generates this.
ASME_SECRET_KEY=change-this-secret
# SQLAlchemy connection string. SQLite is for development only: production
# refuses to start on it, because a hosted container's filesystem is erased on
# every deploy. Hosted PostgreSQL looks like
# postgresql://user:password@host:5432/dbname?sslmode=require
# A DATABASE_URL injected by the host is used when this is unset, and a legacy
# postgres:// scheme is rewritten to postgresql:// automatically.
ASME_DATABASE_URL=sqlite:///inventory.db
# Port the development server listens on. Hosts set this themselves.
PORT=5000
# The address members type into their browser, with no path and no trailing
# slash (for example https://asme-ops.netlify.app). Password reset and invite
# e-mails link to it. Required in production once SMTP is configured.
ASME_PUBLIC_BASE_URL=
# Rotate to a new value to sign every session out on purpose. Leave empty to
# derive it from ASME_SECRET_KEY, which keeps sessions valid across restarts.
ASME_APP_BOOT_TOKEN=
# Two variables the app reads but you normally do not set by hand:
#   DATABASE_URL  some hosts inject this; used only when ASME_DATABASE_URL is empty.
#   FLASK_DEBUG   only decides the default of ASME_ENV when that is unset.
# Setting ASME_ENV explicitly, as this file does, makes both irrelevant.

# ------------------------------------------------------- the front end on Netlify
# Set these two in Netlify (Site configuration -> Environment variables), not
# here: they are read at build time by the React app, not by Flask.
#   ASME_API_ORIGIN   the backend address the screens call, for example
#                     https://asme-ops-api.onrender.com - no path, no trailing
#                     slash. Without it the site deploys but nobody can sign in.
#   VITE_BASE_PATH    already set to "/" in netlify.toml; leave it alone.

# ------------------------------------------------------- first administrator
# Used only when the account does not exist yet. Changing the e-mail after the
# first deploy creates a second administrator on the next deploy.
ASME_DEFAULT_ADMIN_EMAIL=admin@uiowa.edu
# The password the first administrator is created with. Change your password
# inside the app after signing in; editing this afterwards has no effect.
# These two values are fine for a throwaway local database and ONLY there: they
# are printed in a public repository, so with ASME_ENV=production the app
# refuses to start until both are replaced with passwords you invent (8
# characters minimum, 16+ in practice). Set them in the hosting dashboard, never
# in a file. On Render, render.yaml asks you for the admin one and generates the
# user one.
ASME_DEFAULT_ADMIN_PASSWORD=ChangeMe123!
# Password given to accounts created by a bulk roster import.
ASME_DEFAULT_USER_PASSWORD=ChangeMe123!
# Comma-separated addresses always treated as legacy administrators.
ASME_ADMIN_EMAILS=admin@uiowa.edu

# ------------------------------------------------------- sessions and security
# Send cookies only over HTTPS. 1 anywhere the app is reachable over the
# internet; 0 for plain-http local development.
ASME_SESSION_COOKIE_SECURE=0
# Lax is right when the screens and the API share one address (the Netlify
# proxy arranges that). None additionally requires the Secure flag above.
ASME_SESSION_COOKIE_SAMESITE=Lax
# Sign a member out after this many idle minutes (0 disables the check).
ASME_SESSION_IDLE_MINUTES=240
# Administrators get a shorter idle timeout.
ASME_ADMIN_SESSION_IDLE_MINUTES=30
# Failed-login window, in seconds, and how many attempts it allows.
ASME_LOGIN_RATE_WINDOW_SECONDS=900
ASME_LOGIN_RATE_MAX_ATTEMPTS=8
# How many proxies add to X-Forwarded-For in front of the app. 0 (correct for
# local development) uses the socket address, which nobody can fake. Behind
# Netlify and the hosting platform's router the value is 2. Setting it too high
# lets a caller choose the address recorded for them; too low puts every
# visitor in one rate-limit bucket.
ASME_TRUSTED_PROXY_COUNT=0
# Hashing cost used for bulk-created accounts.
ASME_BULK_PASSWORD_HASH_METHOD=pbkdf2:sha256:120000

# ------------------------------------------------------- schema and background jobs
# Run migrations and seeds at startup. Default: on outside production. Leave 0
# in production and run `python manage.py upgrade` as part of the deploy, so the
# migration runs once rather than once per web process.
ASME_AUTO_MIGRATE=
# Run the outbox worker (calendar sync, mail, nightly stock reconciliation) in a
# thread inside the web process. Set to 0 only if a separate
# `python manage.py worker` process is running, or nothing runs those jobs.
ASME_OUTBOX_WORKER=1
# Seconds between outbox polls.
ASME_OUTBOX_POLL_SECONDS=15

# ------------------------------------------------------- file attachments
# local is the only implemented backend; s3 is refused at startup.
ASME_STORAGE_BACKEND=local
# Absolute path attachments are written to. Leave empty for instance/uploads in
# development. In production this must be the mount point of a persistent disk,
# for example /var/asme-uploads, or the flag below must be set.
ASME_UPLOAD_ROOT=
# Agree that attachments are stored on a disk the host erases on every deploy.
# Production refuses to start without either this or ASME_UPLOAD_ROOT, so that
# files are never lost silently. Leave empty unless that trade-off is accepted.
# Demonstration deployment: allows a throwaway file database in production and
# warns on every start. Never set this on the chapter's real installation.
ASME_DEMO_MODE=

ASME_UPLOADS_EPHEMERAL_OK=
# Largest single attachment, in megabytes.
ASME_UPLOAD_MAX_MB=25
# Seconds a signed attachment download link stays valid.
ASME_OPS_DOWNLOAD_TTL_SECONDS=300
# Largest print-job upload, in megabytes.
ASME_PRINT_MAX_UPLOAD_MB=50

# ------------------------------------------------------- operations screens
# How often the screens poll /api/v1/changes for updates, in seconds.
ASME_OPS_POLL_SECONDS=15
# Minutes before a due check-in counts as "due soon".
ASME_CHECKIN_SOON_WINDOW_MINUTES=20
# 0 = onboarding gates are evaluated and logged but never block. 1 = enforce.
ASME_ONBOARDING_ENFORCE=0

# ------------------------------------------------------- e-mail (optional)
# Password reset e-mails are only sent when both user and pass are set, and
# production then also requires ASME_PUBLIC_BASE_URL.
ASME_SMTP_HOST=smtp.office365.com
ASME_SMTP_PORT=587
ASME_SMTP_USER=
ASME_SMTP_PASS=
# Address notified when a booking is cancelled.
ASME_CANCEL_NOTIFY_TO=

# ------------------------------------------------------- calendars (optional)
# google | outlook - which provider the calendar screens use.
ASME_CALENDAR_PROVIDER=google
# Read-only embed URLs shown on the calendar page.
ASME_GOOGLE_CALENDAR_EMBED_URL=
ASME_OUTLOOK_CALENDAR_EMBED_URL=
# Google booking: raw service-account JSON, or an absolute path to a key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID_ROBOTICS=
GOOGLE_CALENDAR_ID_FLUIDS=
GOOGLE_CALENDAR_TIMEZONE=America/Chicago
# How many days ahead room availability is offered, and the bookable hours.
CALENDAR_SCHEDULING_DAYS=14
CALENDAR_WORK_HOURS_START=08:00
CALENDAR_WORK_HOURS_END=22:00
# Outlook booking: these four are set together or not at all.
ASME_OUTLOOK_TENANT_ID=
ASME_OUTLOOK_CLIENT_ID=
ASME_OUTLOOK_CLIENT_SECRET=
ASME_OUTLOOK_CALENDAR_USER=
ASME_OUTLOOK_CALENDAR_ID=
ASME_OUTLOOK_CALENDAR_ROBOTICS_ID=
ASME_OUTLOOK_CALENDAR_FLUIDS_ID=
ASME_OUTLOOK_CALENDAR_TZ=Central Standard Time

# ------------------------------------------------------- printers (optional)
# Shell commands used to send a file to each printer. Empty disables printing.
ASME_H2S_PRINT_CMD=
ASME_P1S_PRINT_CMD=

# ------------------------------------------------------- analytics assistant (optional)
# API key for the administrator analytics assistant. Empty disables it.
ANTHROPIC_API_KEY=
ASME_ASSISTANT_MODEL=claude-sonnet-5
